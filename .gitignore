# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv
!import_parts.csv
# Fab packages produced by .claude/skills/fab-export are archived deliberately
!BOM-*.csv
!CPL-*.csv

# VS Code Local History extension
.history/
.history_trim/

# macOS Finder metadata
.DS_Store

# Transient tool logs (analyzer/exporter stderr captures)
*.err
